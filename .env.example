# Set these privately in Hostinger's environment-variable dashboard.
# npm start reads process environment; this file is a template, not loaded automatically.
NODE_ENV=production
APP_URL=https://your-domain.example
PORT=3000
HOST=0.0.0.0
# Create a MySQL database and user in hPanel. URL-encode special password characters.
DATABASE_URL=mysql://USERNAME:PASSWORD@DATABASE_HOST:3306/DATABASE_NAME
# Use true for an external database requiring trusted TLS; follow your database provider.
DATABASE_SSL=false
PORTFOLIO_ADMIN_EMAIL=venkatani@portfolio.com
# Set privately; 12–256 characters. Bootstrap runs only when no admin exists.
PORTFOLIO_ADMIN_PASSWORD=
# VPS alternative: omit DATABASE_URL and set a durable absolute directory outside the app.
# PORTFOLIO_DATA_DIR=/var/lib/animakesfilms
